{
  "name": "subscriptions_sdk",
  "version": "1.2.0",
  "installs": [
    {
      "from": "templates/pages/subscriptions",
      "to": "lib/presentation/pages/subscriptions"
    }
  ],
  "routes": [
    {
      "path": "/subscriptions",
      "page": "ManagerSubscriptionsRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/pages/subscriptions/subscriptions_page.dart"
    }
  ],
  "database": {
    "tables": [
      {
        "class": "UserSubscriptionsTable",
        "import": "package:subscriptions_sdk/src/common/infrastructure/database/drift_tables.dart"
      }
    ],
    "migration": {
      "version": 15,
      "step": "if (from < 15) { await m.createTable(userSubscriptionsTable); }"
    }
  },
  "integrations": []
}
